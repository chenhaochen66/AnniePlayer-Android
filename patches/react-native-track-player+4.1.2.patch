+                val available = preloadQueue.indices.filter { it != currentQueueIndex }
+                if (available.isEmpty()) return@launch
+                available.random()
+            } else {
+                if (currentQueueIndex <= 0) preloadQueue.size - 1 else currentQueueIndex - 1
+            }
