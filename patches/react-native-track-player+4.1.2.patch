+    @MainThread
+    fun startPreloader() {
+        preloadJob?.cancel()
+        preloadJob = scope.launch {
+            while (true) {
+                delay(1000)
+                if (!::player.isInitialized || !playWhenReady) continue
+                if (player.items.isEmpty() || player.currentIndex < 0) continue
+                val nextIndex = player.currentIndex + 1
+                if (nextIndex >= preloadQueue.size) {
+                    Timber.d("[preloader] no more tracks in queue")
+                    continue
+                }
+                if (nextIndex < player.items.size) {
+                    Timber.d("[preloader] track $nextIndex already in player")
+                    continue
+                }
+                val dur = player.duration
+                if (dur <= 0 || dur - player.position > 30000) continue
+                val nextItem = preloadQueue[nextIndex]
+                Timber.d("[preloader] fetching url for ${nextItem.id}")
+                val url = withContext(Dispatchers.IO) {
+                    fetchPreloadUrl(nextItem)
+                }
+                if (url == null) {
+                    Timber.d("[preloader] fetch failed for ${nextItem.id}")
+                    continue
+                }
+                val currentNextIdx = player.currentIndex + 1
+                if (currentNextIdx >= preloadQueue.size || currentNextIdx < player.items.size) continue
+                if (currentNextIdx != nextIndex) continue
+                Timber.d("[preloader] adding track ${nextItem.id} url=${url.take(60)}")
+                add(Track(this@MusicService, Bundle().apply {
+                    putString("id", nextItem.id)
+                    putString("url", url)
+                    putString("title", nextItem.title)
+                    putString("artist", nextItem.artist)
+                    putString("artwork", nextItem.cover)
+                    putString("album", nextItem.album)
+                }, this@MusicService.ratingType))
+            }
+        }
+    }
