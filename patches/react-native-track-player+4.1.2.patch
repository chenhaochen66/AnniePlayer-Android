+        val nextAbsIdx = preloadBaseIndex + nextRelIdx
+        var count = 0
+        for (absIdx in nextAbsIdx until preloadQueue.size) {
+            if (count >= maxCount) break
+            val url = urlCache[absIdx]
+            if (url == null) break
+            val item = preloadQueue[absIdx] ?: continue
+            add(Track(this@MusicService, Bundle().apply {
