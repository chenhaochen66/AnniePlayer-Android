+                val rawId = item.id.replace("netease:", "")
+                val payload = """{"source":"wy","musicId":$rawId,"quality":"128k"}"""
+                var lastError: String? = null
+                for (attempt in 0 until 3) {
+                    if (attempt > 0) Thread.sleep(500)
+                    try {
+                        val conn = URL("https://c.wwwweb.top/music/url").openConnection() as HttpURLConnection
+                        conn.requestMethod = "POST"
+                        conn.doOutput = true
+                        conn.setRequestProperty("User-Agent", "lx-music-mobile/2.0.0")
+                        conn.setRequestProperty("Content-Type", "application/json")
+                        conn.connectTimeout = 15000
+                        conn.readTimeout = 15000
+                        conn.outputStream.write(payload.toByteArray())
+                        val resp = conn.inputStream.bufferedReader().readText()
+                        val json = JSONObject(resp)
+                        if (json.optInt("code") == 200) {
+                            val url = json.optString("url")
+                            if (url != null) return@fetchPreloadUrl url
+                        }
+                        lastError = resp.take(200)
+                    } catch (e: Exception) {
+                        lastError = e.message
+                    }
+                }
+                Timber.e("Preload netease failed after 3 retries: $lastError")
+                null
+            } else {
